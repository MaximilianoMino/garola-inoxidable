---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import heroBgImg from "@assets/garola-home-hero.webp";
import logo from "@assets/garola_logo_white.webp";
---

<section class="relative overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0">
    <Image
      src={heroBgImg}
      alt="Equipamiento industrial en acero inoxidable - Garola Inoxidable"
      class="w-full h-full object-cover saturate-[0.85] contrast-[1.1] brightness-[0.9]"
      width={2070}
      height={1380}
      decoding="sync"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0
         bg-linear-to-r
         from-[#0b1220]/95
         via-[#0b1220]/85
         to-[#0b1220]/60"
    >
    </div>
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <!-- Content -->
  <div
    class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8 py-24 animate-fadeInUp"
  >
    <div class="max-w-4xl">
      {/* Logo */}
      <Image
        src={logo}
        alt="GAROLA INOXIDABLE"
        class="w-80 md:w-full md:h-48 max-w-sm mb-4"
        width={600}
        height={150}
        decoding="async"
        fetchpriority="high"
      />

      {/* Título principal */}
      <h1
        class="text-2xl md:text-3xl font-bold text-white mb-6 leading-tight max-w-2xl"
      >
        Tecnología en acero inoxidable aplicada al trabajo real del tambo y la
        industria alimenticia.
      </h1>

      {/* Texto descriptivo */}
      <p class="text-lg text-slate-200 mb-8 max-w-2xl leading-relaxed">
        Desarrollamos equipamiento y soluciones técnicas que mejoran los
        procesos productivos, combinando ingeniería, experiencia en el sector y
        adaptación a cada instalación.
      </p>

      {/* Botones */}
      <div class="flex flex-col sm:flex-row gap-4 tracking-widest">
        <Button
          href="/#products"
          size="md"
          class="bg-red-600 hover:bg-red-700 text-sm rounded-none! uppercase text-white shadow-2xl!"
        >
          Ver productos
        </Button>
        <Button
          href="/rfq"
          size="md"
          variant="outline"
          class="border-2! border-white! text-sm rounded-none! uppercase text-white! hover:bg-white/10! shadow-2xl!"
        >
          Consultar
        </Button>
      </div>
    </div>
  </div>

  {/* Stats bar */}
  <div class="relative z-20 border-t border-slate-700/50 mx-16">
    <div
      class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-0 md:justify-between md:items-center"
    >
      <div class="md:flex-1">
        <span class="text-5xl md:text-6xl font-extrabold text-red-600">40+</span
        >
        <p class="text-sm text-slate-300 uppercase tracking-wider mt-2">
          Años de experiencia
        </p>
      </div>
      <div
        class="md:flex-1 md:text-center md:border-l md:border-slate-700/50 md:pl-8"
      >
        <h3 class="text-lg font-semibold text-white uppercase tracking-tight">
          Equipamiento para tambos
        </h3>
        <p class="text-sm text-slate-400 uppercase tracking-wider mt-2">
          e industria alimenticia
        </p>
      </div>
      <div
        class="md:flex-1 md:text-right md:border-l md:border-slate-700/50 md:pl-8"
      >
        <h3 class="text-lg font-semibold text-white uppercase tracking-tight">
          Desarrollos a medida
        </h3>
        <p class="text-sm text-slate-400 uppercase tracking-wider mt-2">
          en acero inoxidable
        </p>
      </div>
    </div>
  </div>
</section>
