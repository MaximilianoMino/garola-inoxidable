---
import BaseLayout from "../layouts/BaseLayout.astro";
import PremiumHero from "../components/home/PremiumHero.astro";
import AboutUs from "../components/home/AboutUs.astro";
import ServiceHighlights from "../components/home/ServiceHighlights.astro";
import ProductSlider from "../components/home/ProductSlider.astro";
import TechnologyInnovation from "../components/react/TechnologyInnovation";
import BlogPreview from "../components/home/BlogPreview.astro";
import { getSortedPosts } from "@/data/getSortedPosts";

const posts = await getSortedPosts();
let hasPosts = posts.length > 0;
---

<BaseLayout>
  <PremiumHero />
  <AboutUs />
  <ServiceHighlights />
  <TechnologyInnovation client:visible />
  <section id="products">
    <ProductSlider />
  </section>
  {hasPosts && <BlogPreview />}
</BaseLayout>
