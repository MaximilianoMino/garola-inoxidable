---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { getProducts } from "@/lib/contentful/products";
import { CATEGORIES } from "@/data/content";
import { ArrowUpRight } from "lucide-react";
import heroImg from "@assets/garola-about-us-hero.webp";

const products = await getProducts();

const getCatLabel = (catIds: string[]) =>
  CATEGORIES.find((c) => c.id === catIds?.[0])?.label ?? catIds?.[0] ?? "";

const getCatId = (catIds: string[]) => catIds?.[0] ?? "";
---

<BaseLayout title="Productos - Garola Inoxidable">
  <!-- Hero compacto -->
  <section class="relative h-[40vh] min-h-[300px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroImg}
        alt="Equipamiento industrial Garola"
        class="w-full h-full object-cover opacity-30"
        width={2070}
        height={600}
        decoding="async"
      />
      <div class="absolute inset-0 bg-linear-to-r from-[#14171A]/95 via-[#14171A]/85 to-[#14171A]/70"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="border-l-4 border-red-600 pl-6">
          <span class="text-red-500 uppercase tracking-widest font-semibold text-sm">
            Soluciones en acero inoxidable
          </span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mt-2 uppercase tracking-tight">
            Nuestros <span class="text-red-600">Productos</span>
          </h1>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo -->
  <section class="py-24 bg-[#14171A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Filtros - Desktop (tabs) */}
      <div class="hidden md:flex gap-3 mb-12" id="category-tabs">
        {CATEGORIES.map((cat) => (
          <button
            class:list={[
              "category-tab cursor-pointer px-5 py-2.5 text-sm font-semibold uppercase tracking-wider border transition-all",
              cat.id === "todos"
                ? "bg-red-600 text-white border-red-600"
                : "bg-transparent text-slate-400 border-slate-700 hover:text-white hover:border-slate-500",
            ]}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>

      {/* Filtros - Mobile (dropdown) */}
      <div class="md:hidden mb-12">
        <select
          id="category-select"
          class="w-full px-4 py-3 bg-[#1a1f24] border border-slate-700 text-white text-sm font-semibold uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-red-600 appearance-none"
        >
          {CATEGORIES.map((cat) => (
            <option value={cat.id}>{cat.label}</option>
          ))}
        </select>
      </div>

      {products.length > 0 ? (
        /* Grid de productos */
        <div class="relative grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
          {/* Loading overlay */}
          <div id="grid-loading" class="absolute inset-0 bg-[#14171A]/80 flex items-center justify-center z-10 hidden">
            <div class="w-8 h-8 border-2 border-red-600 border-t-transparent animate-spin"></div>
          </div>
          {products.map((product) => (
            <div
              class="product-card group bg-[#1a1f24] border border-slate-800 rounded overflow-hidden hover:border-red-600/30 transition-all"
              data-category={getCatId(product.category)}
            >
              {/* Imagen */}
              <div class="relative h-56 overflow-hidden">
                <img
                  src={product.image}
                  alt={product.title}
                  class="w-full h-full object-cover lg:grayscale group-hover:grayscale-0 transition-all duration-700 scale-105 group-hover:scale-100"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

                {/* Badge de categoría */}
                <span class="absolute top-4 left-4 text-xs font-semibold text-white px-3 py-1 rounded-none bg-red-600 uppercase">
                  {getCatLabel(product.category)}
                </span>
              </div>

              {/* Info */}
              <div class="p-6">
                <h3 class="text-lg font-bold text-white mb-3 uppercase tracking-tight group-hover:text-red-500 transition-colors">
                  {product.title}
                </h3>

                {product.pdf && (
                  <a
                    href={product.pdf}
                    target="_blank"
                    class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-slate-400 hover:text-white transition-colors"
                  >
                    Ficha técnica <ArrowUpRight className="w-4 h-4" />
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      ) : (
        /* Empty state */
        <div class="flex flex-col items-center justify-center text-center py-32 border border-dashed border-slate-700 rounded bg-[#1a1f24]">
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-4 uppercase">
            Catálogo en preparación
          </h2>
          <p class="text-slate-400 max-w-xl leading-relaxed">
            Estamos cargando nuestros productos en el sistema. Pronto podrás ver
            todo nuestro equipamiento industrial en acero inoxidable.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

{products.length > 0 && (
<script>
  const tabs = document.querySelectorAll(".category-tab");
  const cards = document.querySelectorAll(".product-card");
  const loadingEl = document.getElementById("grid-loading");
  const selectEl = document.getElementById("category-select") as HTMLSelectElement | null;

  function filterProducts(category: string) {
    // Mostrar loading
    loadingEl?.classList.remove("hidden");

    // Aplicar filtro después de breve pausa
    setTimeout(() => {
      cards.forEach((card) => {
        const cardCat = (card as HTMLElement).dataset.category;
        if (category === "todos" || cardCat === category) {
          (card as HTMLElement).style.display = "";
        } else {
          (card as HTMLElement).style.display = "none";
        }
      });
      loadingEl?.classList.add("hidden");
    }, 300);
  }

  function updateTabStyles(activeTab: Element) {
    tabs.forEach((t) => {
      t.classList.remove("bg-red-600", "text-white", "border-red-600");
      t.classList.add("bg-transparent", "text-slate-400", "border-slate-700");
    });
    activeTab.classList.remove("bg-transparent", "text-slate-400", "border-slate-700");
    activeTab.classList.add("bg-red-600", "text-white", "border-red-600");
  }

  // Tabs (desktop)
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const category = (tab as HTMLElement).dataset.category ?? "todos";
      updateTabStyles(tab);
      filterProducts(category);
    });
  });

  // Dropdown (mobile)
  selectEl?.addEventListener("change", () => {
    filterProducts(selectEl.value);
  });
</script>
)}
