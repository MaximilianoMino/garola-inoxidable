---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Section from "@/components/ui/Section.astro";
import { Image } from "astro:assets";
import { ArrowRight, Calendar } from "lucide-react";
import { getSortedPosts } from "@/data/getSortedPosts";
import heroImg from "@assets/garola-about-us-hero.webp";

const posts = await getSortedPosts();
const hasPosts = posts.length > 0;
---

<BaseLayout title="Blog Técnico - Garola Inoxidable">
  <!-- Hero compacto -->
  <section class="relative h-[40vh] min-h-[300px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroImg}
        alt="Taller Garola Inoxidable"
        class="w-full h-full object-cover opacity-30"
        width={2070}
        height={600}
        decoding="async"
      />
      <div class="absolute inset-0 bg-linear-to-r from-[#14171A]/95 via-[#14171A]/85 to-[#14171A]/70"></div>
    </div>

    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <div class="border-l-4 border-red-600 pl-6">
          <span class="text-red-500 uppercase tracking-widest font-semibold text-sm">
            Actualidad Industrial
          </span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mt-2 uppercase tracking-tight">
            Blog <span class="text-red-600">Técnico</span>
          </h1>
        </div>
      </div>
    </div>
  </section>

  <!-- Contenido del blog -->
  <Section background="dark">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">

      {
        hasPosts ? (
          <!-- Grid de artículos -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
            {posts.map((post) => (
              <article class="group bg-[#1a1f24] border border-slate-800 rounded overflow-hidden hover:border-red-600/50 transition-all duration-300 flex flex-col">
                
                <!-- Imagen -->
                <div class="relative h-56 overflow-hidden bg-[#0b1220]" style="aspect-ratio: 16/9;">
                  {post.image ? (
                    <img
                      src={post.image}
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                  ) : (
                    <div class="w-full h-full bg-linear-to-br from-[#14171A] via-[#1a1f24] to-[#0b1220] flex items-center justify-center">
                      <span class="text-4xl font-extrabold text-white/90 tracking-widest uppercase">GAROLA</span>
                    </div>
                  )}

                  <span class="absolute top-4 left-4 text-xs font-semibold text-white px-3 py-1 rounded-none bg-red-600 uppercase">
                    {post.category}
                  </span>
                </div>

                <!-- Contenido -->
                <div class="p-6 flex flex-col flex-grow">
                  <div class="flex items-center gap-2 text-slate-500 text-xs mb-3">
                    <Calendar className="w-3 h-3" />
                    {post.publishedAt.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" })}
                  </div>

                  <h3 class="text-xl font-bold text-white mb-3 leading-tight group-hover:text-red-500 transition-colors">
                    <a href={`/blog/${post.slug}`}>
                      {post.title}
                    </a>
                  </h3>

                  <p class="text-slate-400 text-sm leading-relaxed mb-6 flex-grow">
                    {post.description}
                  </p>

                  <a
                    href={`/blog/${post.slug}`}
                    class="mt-auto inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-white hover:text-red-500 transition-colors"
                  >
                    Leer más
                    <ArrowRight className="w-4 h-4 transition-transform group-hover:translate-x-1" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <!-- Empty state -->
          <div class="flex flex-col items-center justify-center text-center py-32 border border-dashed border-slate-700 rounded bg-[#1a1f24]">
            <span class="text-red-500 uppercase tracking-widest font-semibold text-sm mb-4">
              Blog técnico
            </span>

            <h2 class="text-2xl md:text-3xl font-bold text-white uppercase mb-4">
              Contenido en preparación
            </h2>

            <p class="text-slate-400 max-w-xl leading-relaxed">
              Estamos documentando procesos, decisiones de diseño y experiencias reales
              de nuestros sistemas industriales.  
              Este espacio se irá completando con material técnico y casos reales.
            </p>
          </div>
        )
      }

    </div>
  </Section>
</BaseLayout>